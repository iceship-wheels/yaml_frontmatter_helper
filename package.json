{
  "name": "yaml-frontmatter-helper",
  "displayName": "YAML Frontmatter Helper",
  "description": "Sidebar panel for viewing and editing YAML front matter in Markdown files",
  "version": "0.1.0",
  "publisher": "openpets",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onView:yaml-frontmatter-helper.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yaml-frontmatter-helper",
          "title": "YAML Frontmatter",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "yaml-frontmatter-helper": [
        {
          "type": "webview",
          "id": "yaml-frontmatter-helper.sidebar",
          "name": "Frontmatter"
        }
      ]
    },
    "configuration": {
      "title": "YAML Frontmatter Helper",
      "properties": {
        "yaml-frontmatter-helper.maxDepth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum nesting depth of YAML front matter rendered and editable in the sidebar. Deeper content is collapsed behind a placeholder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "build:webview": "vite build --config vite.webview.config.ts",
    "dev:webview": "vite build --config vite.webview.config.ts --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "yaml": "^2.5.0"
  }
}
